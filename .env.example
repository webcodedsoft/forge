# Copy to .env and fill in. Never commit .env.

# Local Postgres from docker-compose.yml
DATABASE_URL=postgres://forge:forge@127.0.0.1:5433/forge

# Random 32+ char string for signing sessions: openssl rand -base64 32
BETTER_AUTH_SECRET=
# URL the browser uses to reach Forge (the web app, which proxies /api to the orchestrator)
BETTER_AUTH_URL=http://localhost:4310

# Comma-separated email domains allowed to sign up (e.g. yourcompany.com). Empty = anyone.
ALLOWED_EMAIL_DOMAINS=

ORCHESTRATOR_PORT=8790
PREVIEW_PORT=7777

# Needed from phase 1 (agent runs). Leave empty until then.
ANTHROPIC_API_KEY=

# Optional local browser-testing account (dev only)
DEV_TEST_EMAIL=
DEV_TEST_PASSWORD=

# Optional: key for project secrets (openssl rand -base64 32). Derived from BETTER_AUTH_SECRET when unset.
# FORGE_SECRETS_KEY=

# Optional: a Figma access token for Design mode. Usually set in Settings › Integrations instead.
FIGMA_TOKEN=
