# Copy to .env and fill in. Never commit .env.

# Local Postgres from docker-compose.yml
DATABASE_URL=postgres://forge:forge@127.0.0.1:5433/forge

# Random 32+ char string for signing sessions: openssl rand -base64 32
BETTER_AUTH_SECRET=
# URL the browser uses to reach Forge (the web app, which proxies /api to the orchestrator)
BETTER_AUTH_URL=http://localhost:4310

# Comma-separated email domains allowed to sign up (e.g. yourcompany.com). Empty = anyone.
ALLOWED_EMAIL_DOMAINS=

ORCHESTRATOR_PORT=8790
PREVIEW_PORT=7777

# AI keys: add them in Settings › Integrations › AI model (stored encrypted). These are only
# a fallback for setups without the UI; a key added in Settings wins.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Optional local browser-testing account (dev only)
DEV_TEST_EMAIL=
DEV_TEST_PASSWORD=

# Optional: key for project secrets (openssl rand -base64 32). Derived from BETTER_AUTH_SECRET when unset.
# FORGE_SECRETS_KEY=

# Optional: a Figma access token for Design mode. Usually set in Settings › Integrations instead.
FIGMA_TOKEN=

# AI cost controls (all optional; these are the defaults).
# The most one request may spend before the agent is stopped, in USD (0 = no limit).
# FORGE_RUN_BUDGET_USD=5
# A project's agent conversation starts fresh (with a summary) when it is larger than MAX tokens,
# or idle for IDLE_MIN minutes and larger than IDLE_TOKENS. 0 turns a rule off.
# FORGE_SESSION_MAX_TOKENS=90000
# FORGE_SESSION_IDLE_MIN=5
# FORGE_SESSION_IDLE_TOKENS=40000
# The test agent uses the cheapest allowed model. Set "provider:model" to pick one, or "default"
# to test with the workspace's default model.
# FORGE_QA_MODEL=default
# ChatGPT reasoning effort for building steps: low, medium or high.
# FORGE_OPENAI_EFFORT=medium
