# Copy to deploy/.env on the server and fill in. Never commit deploy/.env.

# --- Addresses (placeholders: replace with your real domains) ---
FORGE_DOMAIN=forge.example.com
PREVIEW_DOMAIN=preview.forge.example.com

# --- HTTPS: letsencrypt-azure | company-ca | internal ---
TLS_MODE=internal

# --- Secrets ---
POSTGRES_PASSWORD=
# openssl rand -base64 32
BETTER_AUTH_SECRET=
ANTHROPIC_API_KEY=
# Encrypts project secrets. openssl rand -base64 32. Back it up: without it, saved secrets can't be read.
FORGE_SECRETS_KEY=
# Model for the build and QA agents.
FORGE_MODEL=claude-opus-5-5

# --- Who may sign up (comma-separated email domains) ---
ALLOWED_EMAIL_DOMAINS=example.com

# --- GitHub (import repos / open pull requests) ---
# Token of a GitHub service account with access to the team's repos (repo scope).
GH_TOKEN=

# --- Only for TLS_MODE=letsencrypt-azure ---
AZURE_TENANT_ID=
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=
AZURE_SUBSCRIPTION_ID=
AZURE_DNS_RESOURCE_GROUP=
